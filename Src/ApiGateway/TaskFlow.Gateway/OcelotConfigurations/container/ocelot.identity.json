{
  "Routes": [
    {
      "Key": "identity_service_health_check",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service.api",
          "Port": 8080
        }
      ],
      "DownstreamPathTemplate": "/health",
      "UpstreamPathTemplate": "/identity-service/health",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "Key": "identity_service_auth_register",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service.api",
          "Port": 8080
        }
      ],
      "DownstreamPathTemplate": "/api/auth/register",
      "UpstreamPathTemplate": "/auth/register",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "Key": "identity_service_auth_login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service.api",
          "Port": 8080
        }
      ],
      "DownstreamPathTemplate": "/api/auth/login",
      "UpstreamPathTemplate": "/auth/login",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "Key": "identity_service_auth_logout",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-service.api",
          "Port": 8080
        }
      ],
      "DownstreamPathTemplate": "/api/auth/logout",
