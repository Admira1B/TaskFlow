{
  "ConnectionStrings": {
    "SqlServerConnectionString": "Server=${SQL_SERVER_HOST};Database=${SQL_SERVER_DB_NAME};User Id=${SQL_SERVER_USER};Password=${SQL_SERVER_PASSWORD};TrustServerCertificate=True;"
  },
  "JsonWebTokenOptions": {
    "Issuer": "${JWT_GENERATION_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "SecretKey": "${JWT_GENERATION_SECRET_KEY}"
  },
  "RabbitMqOptions": {
    "UserName": "${RABBITMQ_USERNAME}",
    "Password": "${RABBITMQ_PASSWORD}",
    "Port": "${RABBITMQ_PORT}",
    "VirtualHost": "${RABBITMQ_VIRTUAL_HOST}",
    "HostName": "${RABBITMQ_HOSTNAME}"
  },
  "JsonWebTokenGenerationOptions": {
    "Issuer": "${JWT_GENERATION_ISSUER}",
    "ValidAudiences": "${JWT_GENERATION_VALID_AUDIENCES}",
    "SecretKey": "${JWT_GENERATION_SECRET_KEY}",
    "ExpiresHours": "${JWT_GENERATION_EXPIRES_HOURS}"
  }
}