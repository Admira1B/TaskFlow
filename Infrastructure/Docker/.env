# === Image versions === #
CONSUL_VER=1.22.3
SQL_SERVER_VER=2022-latest
RABBITMQ_VER=3-management-alpine

# === Services hosts === #
CONSUL_HOST=consul
SQL_SERVER_HOST=sqlserver
RABBITMQ_HOST=rabbitmq

# === Microservices hosts === #
IDENTITY_SERVICE_HOST=identity-service
TASKS_SERVICE_HOST=tasks-service
GATEWAY_HOST=gateway

# === Services internal ports === #
CONSUL_INTERNAL_PORT=8500
SQL_SERVER_INTERNAL_PORT=1433
RABBITMQ_AMQP_INTERNAL_PORT=5672
RABBITMQ_MGMT_INTERNAL_PORT=15672

# === Microservices internal ports === #
IDENTITY_SERVICE_INTERNAL_PORT=8080
TASKS_SERVICE_INTERNAL_PORT=8080
GATEWAY_INTERNAL_PORT=8080

# === Consul options === #
CONSUL_DATACENTER=dc1
CONSUL_SERVICE_DISCOVERY=true

# === SQL Server options === #
SQL_SERVER_DATABASE=taskflow

# === RabbitMQ options === #
RABBITMQ_VHOST=/

# === Microservices names === #
IDENTITY_SERVICE_NAME=identity-service
TASKS_SERVICE_NAME=tasks-service
GATEWAY_NAME=gateway

# === Microservices audiences === #
IDENTITY_SERVICE_AUD=identity-service
TASKS_SERVICE_AUD=tasks-service
GATEWAY_AUD=gateway

# === JWT options === #
JWT_EXPIRES_HOURS=8
JWT_ISSUER=identity-service
JWT_SECRET_KEY=qwert-yqaz12-3456-789-taskflow-secret-key-987-6543-21zaqy-trewq
